      "default": "metric",
      "label": {
        "en": "Units of the scenes",
        "fr": "Unités des scènes",
        "de": "Einheiten der Szenen",
        "es": "Unidades de las escenas"
      },
      "description": {
        "en": "Units of the values and texts of the scene actions and triggers. The widgets follow the units of each user.",
        "fr": "Unités des valeurs et des textes des actions et déclencheurs de scène. Les widgets suivent les unités de chaque utilisateur.",
        "de": "Einheiten der Werte und Texte der Szenenaktionen und Auslöser. Die Widgets folgen den Einheiten jedes Benutzers.",
        "es": "Unidades de los valores y textos de las acciones y disparadores de escena. Los widgets siguen las unidades de cada usuario."
      },
      "options": [
        {
          "value": "metric",
          "label": {
            "en": "Metric (°C, hPa)",
            "fr": "Métrique (°C, hPa)",
            "de": "Metrisch (°C, hPa)",
            "es": "Métrico (°C, hPa)"
          }
        },
        {
