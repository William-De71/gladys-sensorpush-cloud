      "key": "diagnostic",
      "timeout_seconds": 10,
      "label": {
        "en": "Diagnostic",
        "fr": "Diagnostic",
        "de": "Diagnose",
        "es": "Diagnóstico"
      },
      "description": {
        "en": "Writes what the integration knows to its logs (no password, no token), for an issue.",
        "fr": "Écrit ce que l’intégration sait dans ses journaux (sans mot de passe ni jeton), pour un ticket.",
        "de": "Schreibt, was die Integration weiß, in ihre Logs (ohne Passwort und Token), für ein Issue.",
        "es": "Escribe lo que sabe la integración en sus registros (sin contraseña ni token), para una incidencia."
      }
    }
  ],
