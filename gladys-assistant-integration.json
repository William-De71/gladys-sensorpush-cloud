        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Signs in to SensorPush and reads the sensors (up to a minute of wait).",
        "fr": "Se connecte à SensorPush et lit les capteurs (jusqu’à une minute d’attente).",
        "de": "Meldet sich bei SensorPush an und liest die Sensoren (bis zu einer Minute Wartezeit).",
        "es": "Se conecta a SensorPush y lee los sensores (hasta un minuto de espera)."
      }
    },
