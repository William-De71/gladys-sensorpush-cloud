{
  "manifest_version": 1,
  "type": "device",
  "name": "SensorPush Cloud",
  "description": {
    "en": "SensorPush sensors via the official cloud API: temperature, humidity, pressure, alerts.",
    "fr": "Capteurs SensorPush par l’API cloud officielle : température, humidité, pression, alertes.",
    "de": "SensorPush-Sensoren über die offizielle Cloud-API: Temperatur, Feuchte, Luftdruck, Alarme.",
    "es": "Sensores SensorPush por la API cloud oficial: temperatura, humedad, presión, alertas."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/william-de71/gladys-sensorpush-cloud:0.1.0",
  "gladys_version": ">=5.3.0",
  "categories": ["environment", "climate"],
  "keywords": [
    "SensorPush",
    "HT1",
    "HT.w",
    "HTP.xw",
    "G1 WiFi Gateway",
    "hygrometer",
    "hygromètre",
    "thermometer",
    "thermomètre",
    "humidité"
  ],
  "cover_image": "https://raw.githubusercontent.com/William-De71/gladys-sensorpush-cloud/main/cover.jpg",
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "SensorPush account",
        "fr": "Compte SensorPush",
        "de": "SensorPush-Konto",
        "es": "Cuenta SensorPush"
      },
      "description": {
        "en": "Enter the e-mail address and the password of your SensorPush account. The integration signs in to the official Gateway Cloud API (api.sensorpush.com) and only reads: the samples travel through the SensorPush cloud, relayed by a SensorPush gateway (G1 WiFi Gateway). A new account must first log in once to the Gateway Cloud Dashboard and accept the API terms. Not affiliated with SensorPush.",
        "fr": "Saisissez l’adresse e-mail et le mot de passe de votre compte SensorPush. L’intégration se connecte à l’API officielle Gateway Cloud (api.sensorpush.com) et ne fait que lire : les mesures passent par le cloud SensorPush, relayées par une passerelle SensorPush (G1 WiFi Gateway). Un nouveau compte doit d’abord se connecter une fois au Gateway Cloud Dashboard et accepter les conditions de l’API. Non affiliée à SensorPush.",
        "de": "Gib die E-Mail-Adresse und das Passwort deines SensorPush-Kontos ein. Die Integration meldet sich bei der offiziellen Gateway-Cloud-API (api.sensorpush.com) an und liest nur: Die Messwerte laufen über die SensorPush-Cloud, weitergeleitet von einem SensorPush-Gateway (G1 WiFi Gateway). Ein neues Konto muss sich zuerst einmal im Gateway Cloud Dashboard anmelden und die API-Bedingungen akzeptieren. Nicht mit SensorPush verbunden.",
        "es": "Introduzca la dirección de correo y la contraseña de su cuenta SensorPush. La integración se conecta a la API oficial Gateway Cloud (api.sensorpush.com) y solo lee: las mediciones pasan por la nube SensorPush, retransmitidas por una pasarela SensorPush (G1 WiFi Gateway). Una cuenta nueva debe conectarse primero una vez al Gateway Cloud Dashboard y aceptar las condiciones de la API. No afiliada a SensorPush."
      },
      "links": [
        {
          "url": "https://dashboard.sensorpush.com/",
          "label": {
            "en": "Gateway Cloud Dashboard",
            "fr": "Gateway Cloud Dashboard",
            "de": "Gateway Cloud Dashboard",
            "es": "Gateway Cloud Dashboard"
          }
        },
        {
          "url": "https://www.sensorpush.com/gateway-cloud-api",
          "label": {
            "en": "SensorPush API documentation",
            "fr": "Documentation de l’API SensorPush",
            "de": "Dokumentation der SensorPush-API",
            "es": "Documentación de la API de SensorPush"
          }
        }
      ]
    },
    {
      "key": "email",
      "type": "string",
      "required": true,
      "label": {
        "en": "E-mail address",
        "fr": "Adresse e-mail",
        "de": "E-Mail-Adresse",
        "es": "Dirección de correo"
      },
      "placeholder": {
        "en": "The e-mail of your SensorPush account",
        "fr": "L’e-mail de votre compte SensorPush",
        "de": "Die E-Mail deines SensorPush-Kontos",
        "es": "El correo de su cuenta SensorPush"
      }
    },
    {
      "key": "password",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "placeholder": {
        "en": "The password of your SensorPush account",
        "fr": "Le mot de passe de votre compte SensorPush",
        "de": "Das Passwort deines SensorPush-Kontos",
        "es": "La contraseña de su cuenta SensorPush"
      }
    },
    {
      "key": "readings",
      "type": "section",
      "label": {
        "en": "Readings and triggers",
        "fr": "Lectures et déclencheurs",
        "de": "Abfragen und Auslöser",
        "es": "Lecturas y disparadores"
      },
      "description": {
        "en": "SensorPush accepts one request a minute at most: the integration never asks more. A gateway relays the sensors about once a minute. The list of the sensors and the gateways is read again every 15 minutes, in place of a sample reading.",
        "fr": "SensorPush accepte au plus une requête par minute : l’intégration ne demande jamais plus. Une passerelle relaie les capteurs environ une fois par minute. La liste des capteurs et des passerelles est relue toutes les 15 minutes, à la place d’une lecture des mesures.",
        "de": "SensorPush akzeptiert höchstens eine Anfrage pro Minute: Die Integration fragt nie öfter. Ein Gateway leitet die Sensoren etwa einmal pro Minute weiter. Die Liste der Sensoren und Gateways wird alle 15 Minuten neu gelesen, anstelle einer Messwertabfrage.",
        "es": "SensorPush acepta como máximo una petición por minuto: la integración nunca pide más. Una pasarela retransmite los sensores aproximadamente una vez por minuto. La lista de sensores y pasarelas se vuelve a leer cada 15 minutos, en lugar de una lectura de mediciones."
      }
    },
    {
      "key": "sample_interval",
      "type": "select",
      "default": "1",
      "label": {
        "en": "Reading of the samples",
        "fr": "Lecture des mesures",
        "de": "Abfrage der Messwerte",
        "es": "Lectura de las mediciones"
      },
      "description": {
        "en": "How often the last sample of every sensor is read (one request for all).",
        "fr": "Fréquence de lecture de la dernière mesure de chaque capteur (une seule requête).",
        "de": "Wie oft der letzte Messwert jedes Sensors gelesen wird (eine Anfrage für alle).",
        "es": "Frecuencia de lectura de la última medición de cada sensor (una sola petición)."
      },
      "options": [
        {
          "value": "1",
          "label": {
            "en": "Every minute",
            "fr": "Toutes les minutes",
            "de": "Jede Minute",
            "es": "Cada minuto"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "Every 2 minutes",
            "fr": "Toutes les 2 minutes",
            "de": "Alle 2 Minuten",
            "es": "Cada 2 minutos"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "Every 5 minutes",
            "fr": "Toutes les 5 minutes",
            "de": "Alle 5 Minuten",
            "es": "Cada 5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "Every 10 minutes",
            "fr": "Toutes les 10 minutes",
            "de": "Alle 10 Minuten",
            "es": "Cada 10 minutos"
          }
        }
      ]
    },
    {
      "key": "silent_after",
      "type": "select",
      "default": "30",
      "label": {
        "en": "Sensor silent after",
        "fr": "Capteur muet après",
        "de": "Sensor stumm nach",
        "es": "Sensor sin señal después de"
      },
      "description": {
        "en": "Time without a new sample before a sensor is silent and the “sensor silent” trigger fires.",
        "fr": "Durée sans nouvelle mesure avant qu’un capteur soit muet et que le déclencheur « capteur muet » se déclenche.",
        "de": "Zeit ohne neuen Messwert, bevor ein Sensor als stumm gilt und der Auslöser „Sensor stumm“ auslöst.",
        "es": "Tiempo sin una nueva medición antes de que un sensor quede sin señal y se active el disparador «sensor sin señal»."
      },
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 hour",
            "fr": "1 heure",
            "de": "1 Stunde",
            "es": "1 hora"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 hours",
            "fr": "2 heures",
            "de": "2 Stunden",
            "es": "2 horas"
          }
        },
        {
          "value": "360",
          "label": {
            "en": "6 hours",
            "fr": "6 heures",
            "de": "6 Stunden",
            "es": "6 horas"
          }
        }
      ]
    },
    {
